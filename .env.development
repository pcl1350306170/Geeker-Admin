# 本地环境
VITE_USER_NODE_ENV = development

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 开发环境接口地址
VITE_API_URL = /api

# blog 后端接口地址（dev 走 vite 代理前缀，见下方 VITE_PROXY）
VITE_BLOG_API_URL = /blog-api

# 开发环境跨域代理（指向本地后端）
VITE_PROXY = [["/api","http://localhost:8880"],["/blog-api","http://localhost:28019"]]
